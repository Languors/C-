/*
思路：
一个问题直接求解时不好求解，如果可以将其划分成其子问题，并且子问题和原问题有相同的解法时，就可以使用递归的方式解决
递归的两个条件：
 1. 将问题划分成其子问题，要求：子问题要与原问题具有相同的解法
 2. 递归的出口
              1                 N < 3              
Fac(N)      
       Fac(N-1) + Fac(N-2)     N >= 3
*/


long long Fac(int N)
{
 if(N < 3)
     return 1;
 
 return Fac(N-1) + Fac(N-2);
}
