思路：
 0. 函数原型设计
 返回值：必须要有返回值，0表示不是素数，1表示是素数
 1. 检测该数据是否为素数，方法参考前文。


*/

#include <stdio.h>
#include<math.h>


int is_prime(int n)
{
	int i = 0;
	for (i = 2; i <= sqrt(n); i++)
	{
		if (0 == n % i)
		{
			return 0;
		}
	}
	return 1;
}




int main()
{
	int i = 0;
	for (i = 100; i <= 200; i++) {
		if (is_prime(i) == 1) {
			printf("%d ", i);
		}
	}
	return 0;
}




